<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page.title | default: site.title }} · {{ site.title }}</title>
    {% assign stylesheet_path = "/assets/css/style.css" %}
    <link rel="stylesheet" href="{{ stylesheet_path | relative_url }}">
  </head>
  <body>
    <header>
      {% assign home_path = "/" %}
      <a href="{{ home_path | relative_url }}">{{ site.title }}</a>
    </header>
    <main>
      {% block content %}{% endblock %}
    </main>
    <footer>
      <p>&copy; {{ site.time }} <%= @site_title %></p>
    </footer>
  </body>
</html>
